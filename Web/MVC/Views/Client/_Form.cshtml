@model Client

<div class="field">
    <label class="field__label" asp-for="ServiceName"></label>
    <input class="input mono" asp-for="ServiceName" placeholder="e.g. food-app"/>
    <span asp-validation-for="ServiceName"></span>
</div>

<div class="field">
    <label class="field__label" asp-for="DisplayName"></label>
    <input class="input" asp-for="DisplayName" placeholder="e.g. Food App"/>
    <span asp-validation-for="DisplayName"></span>
</div>

<label class="check">
    <input asp-for="IsActive"/>
    <span>@Html.DisplayNameFor(m => m.IsActive)</span>
</label>
