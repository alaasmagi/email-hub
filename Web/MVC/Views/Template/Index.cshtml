@model IEnumerable<TemplateIndexRow>

@{
    ViewData["Title"] = "Templates";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">Razor email bodies</p>
        <h1 class="page-title">Templates</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-card">
<table class="table table-hover align-middle">
    <thead>
    <tr>
        <th>Client service</th>
        <th>Sender identity</th>
        <th>Language</th>
        <th>Subject</th>
        <th>Active</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var template in Model)
    {
        <tr>
            <td><code>@template.ClientServiceName</code></td>
            <td>
                <div>@template.SenderEmailType</div>
                <code>@template.SenderFromAddress</code>
            </td>
            <td>@template.Template.LanguageCode</td>
            <td>@template.Template.SubjectTemplate</td>
            <td>
                <span class="status-badge @(template.Template.IsActive ? "is-active" : "")">@(template.Template.IsActive ? "Active" : "Inactive")</span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@template.Template.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@template.Template.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this template?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
