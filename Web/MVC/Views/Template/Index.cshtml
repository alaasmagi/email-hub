@model IEnumerable<TemplateIndexRow>

@{
    ViewData["Title"] = "Templates";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Razor email bodies</p>
        <h1>Templates</h1>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Create template</a>
    </div>
</header>

<partial name="_TempDataAlerts"/>

<div class="card table-card">
    <table class="data-table">
        <thead>
        <tr>
            <th>Client service</th>
            <th>Sender identity</th>
            <th>Language</th>
            <th>Subject</th>
            <th>Status</th>
            <th class="actions-col">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var template in Model)
        {
            <tr>
                <td><code class="code-chip">@template.ClientServiceName</code></td>
                <td>
                    <div class="stack-cell">
                        <span class="mono">@template.SenderEmailType</span>
                        <span>@template.SenderFromAddress</span>
                    </div>
                </td>
                <td><code class="code-chip">@template.Template.LanguageCode</code></td>
                <td>@template.Template.SubjectTemplate</td>
                <td><partial name="_ActiveBadge" model="template.Template.IsActive"/></td>
                <td class="actions-col">
                    <div class="row-actions">
                        <a class="icon-btn" asp-action="Edit" asp-route-id="@template.Template.Id" aria-label="Edit template" title="Edit template"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                        <form asp-action="Delete" asp-route-id="@template.Template.Id" method="post"
                              data-confirm="This action cannot be undone."
                              data-confirm-title="Delete this template?" data-confirm-label="Delete template">
                            <button type="submit" class="icon-btn icon-btn--danger" aria-label="Delete template" title="Delete template"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="empty">No templates yet.</td></tr>
        }
        </tbody>
    </table>
</div>
