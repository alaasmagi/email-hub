@model Template
@{
    var senderIdentities = (IReadOnlyList<SenderIdentityOption>)(ViewBag.SenderIdentities ?? new List<SenderIdentityOption>());
    var selectedSenderIdentity = senderIdentities.FirstOrDefault(x => x.Id == Model.SenderIdentityId) ?? senderIdentities.FirstOrDefault();
}

<div class="form-row form-row--template">
    <div class="field">
        <label class="field__label" asp-for="SenderIdentityId"></label>
        <div class="field__control">
            <select class="input" id="SenderIdentityId" name="SenderIdentityId">
                @foreach (var senderIdentity in senderIdentities)
                {
                    <option value="@senderIdentity.Id" data-service-name="@senderIdentity.ClientServiceName" selected="@(senderIdentity.Id == selectedSenderIdentity?.Id)">
                        @senderIdentity.ClientServiceName — @senderIdentity.EmailType — @senderIdentity.FromAddress
                    </option>
                }
            </select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
        <span asp-validation-for="SenderIdentityId"></span>
    </div>

    <div class="field">
        <label class="field__label" for="ClientServiceName">Client service name</label>
        <input class="input mono" id="ClientServiceName" value="@selectedSenderIdentity?.ClientServiceName" readonly/>
    </div>

    <div class="field">
        <label class="field__label" asp-for="LanguageCode"></label>
        <input class="input mono" asp-for="LanguageCode" placeholder="e.g. en"/>
        <span asp-validation-for="LanguageCode"></span>
    </div>
</div>

<div class="field">
    <label class="field__label" asp-for="SubjectTemplate"></label>
    <textarea class="input mono" asp-for="SubjectTemplate" rows="3"></textarea>
    <span asp-validation-for="SubjectTemplate"></span>
</div>

<div class="field">
    <label class="field__label" asp-for="HtmlBodyTemplate"></label>
    <textarea class="input mono" asp-for="HtmlBodyTemplate" rows="18" spellcheck="false"></textarea>
    <span asp-validation-for="HtmlBodyTemplate"></span>
</div>

<label class="check">
    <input asp-for="IsActive"/>
    <span>@Html.DisplayNameFor(m => m.IsActive)</span>
</label>

<script>
    (() => {
        const senderIdentitySelect = document.getElementById("SenderIdentityId");
        const serviceNameInput = document.getElementById("ClientServiceName");
        if (!senderIdentitySelect || !serviceNameInput) {
            return;
        }

        const syncServiceName = () => {
            serviceNameInput.value = senderIdentitySelect.selectedOptions[0]?.dataset.serviceName || "";
        };

        senderIdentitySelect.addEventListener("change", syncServiceName);
        syncServiceName();
    })();
</script>
