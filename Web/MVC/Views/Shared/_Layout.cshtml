<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Email Hub</title>
    <script>
        (function () {
            var theme = localStorage.getItem("emailHubTheme");
            if (theme !== "light" && theme !== "dark") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
            }
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg app-navbar">
        <div class="container">
            <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="app-brand-mark">EH</span>
                <span>Email Hub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="mainNavigation" class="navbar-collapse collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Client" asp-action="Index">Clients</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="SenderIdentity" asp-action="Index">Senders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Template" asp-action="Index">Templates</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Email" asp-action="Index">Emails</a>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <div class="theme-switch" role="group" aria-label="Theme">
                        <span class="theme-switch-label">Light</span>
                        <button class="theme-switch-control" type="button" id="themeSwitch" aria-label="Switch theme" aria-pressed="false">
                            <span class="theme-switch-thumb"></span>
                        </button>
                        <span class="theme-switch-label">Dark</span>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="app-user">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="app-shell">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="app-footer">
    <div class="container">
        <span>&copy; 2026 Email Hub</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
