@model IEnumerable<Email>

@{
    ViewData["Title"] = "Emails";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Delivery log</p>
        <h1>Emails</h1>
    </div>
</header>

<div class="card table-card">
    <table class="data-table">
        <thead>
        <tr>
            <th>Service</th>
            <th>Type</th>
            <th>To</th>
            <th>Subject</th>
            <th>Status</th>
            <th>Sent at</th>
            <th class="actions-col"><span class="visually-hidden">Actions</span></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var email in Model)
        {
            <tr>
                <td><code class="code-chip">@email.ServiceName</code></td>
                <td class="mono">@email.EmailType</td>
                <td>@email.ToRecipients</td>
                <td>@email.Subject</td>
                <td><partial name="_EmailStatus" model="email.Status"/></td>
                <td class="nowrap mono secondary">@email.SentAt?.ToString("u")</td>
                <td class="actions-col">
                    <a class="btn btn--ghost btn--sm" asp-action="Details" asp-route-id="@email.Id">Details</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="empty">No emails have been sent yet.</td></tr>
        }
        </tbody>
    </table>
</div>
