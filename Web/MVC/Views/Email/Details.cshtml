@model Email

@{
    ViewData["Title"] = "Email details";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Delivery log</p>
        <h1>Email details</h1>
    </div>
</header>

<div class="section medium">
    <dl class="card details">
        <div class="details__row"><dt>Service</dt><dd><code class="code-chip">@Model.ServiceName</code></dd></div>
        <div class="details__row"><dt>Type</dt><dd class="mono">@Model.EmailType</dd></div>
        <div class="details__row"><dt>To</dt><dd>@Model.ToRecipients</dd></div>
        <div class="details__row"><dt>Reply-to</dt><dd>@Model.ReplyTo</dd></div>
        <div class="details__row"><dt>Subject</dt><dd>@Model.Subject</dd></div>
        <div class="details__row"><dt>Status</dt><dd><partial name="_EmailStatus" model="Model.Status"/></dd></div>
        <div class="details__row"><dt>Sent at</dt><dd class="mono">@Model.SentAt?.ToString("u")</dd></div>
    </dl>
    <div><a class="btn btn--secondary" asp-action="Index">Back to emails</a></div>
</div>
