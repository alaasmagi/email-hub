@model SenderIdentity
@{
    var clients = (IReadOnlyList<ClientOption>)(ViewBag.Clients ?? new List<ClientOption>());
    var selectedClient = clients.FirstOrDefault(x => x.Id == Model.ClientId) ?? clients.FirstOrDefault();
}

<div>
    <label class="form-label" asp-for="ClientId"></label>
    <select class="form-select" id="ClientId" name="ClientId">
        @foreach (var client in clients)
        {
            <option value="@client.Id" data-service-name="@client.ServiceName" selected="@(client.Id == selectedClient?.Id)">
                @client.ServiceName - @client.DisplayName
            </option>
        }
    </select>
    <span class="text-danger" asp-validation-for="ClientId"></span>
</div>

<div>
    <label class="form-label" for="ClientServiceName">Client service name</label>
    <input class="form-control font-monospace" id="ClientServiceName" value="@selectedClient?.ServiceName" readonly/>
</div>

<div>
    <label class="form-label" asp-for="EmailType"></label>
    <input class="form-control" asp-for="EmailType" placeholder="e.g user.password.reset, monthly.invoice, daily.lunch.recommendation"/>
    <span class="text-danger" asp-validation-for="EmailType"></span>
</div>

<div>
    <label class="form-label" asp-for="FromAddress"></label>
    <input class="form-control" asp-for="FromAddress"/>
    <span class="text-danger" asp-validation-for="FromAddress"></span>
</div>

<div>
    <label class="form-label" asp-for="DisplayName"></label>
    <input class="form-control" asp-for="DisplayName"/>
    <span class="text-danger" asp-validation-for="DisplayName"></span>
</div>

<div>
    <label class="form-label" asp-for="ReplyTo"></label>
    <input class="form-control" asp-for="ReplyTo"/>
    <span class="text-danger" asp-validation-for="ReplyTo"></span>
</div>

<div class="form-check">
    <input class="form-check-input" asp-for="IsActive"/>
    <label class="form-check-label" asp-for="IsActive"></label>
</div>

<script>
    (() => {
        const clientSelect = document.getElementById("ClientId");
        const serviceNameInput = document.getElementById("ClientServiceName");
        if (!clientSelect || !serviceNameInput) {
            return;
        }

        const syncServiceName = () => {
            serviceNameInput.value = clientSelect.selectedOptions[0]?.dataset.serviceName || "";
        };

        clientSelect.addEventListener("change", syncServiceName);
        syncServiceName();
    })();
</script>
