@model SenderIdentity
@{
    var clients = (IReadOnlyList<ClientOption>)(ViewBag.Clients ?? new List<ClientOption>());
    var selectedClient = clients.FirstOrDefault(x => x.Id == Model.ClientId) ?? clients.FirstOrDefault();
}

<div class="form-row form-row--sender">
    <div class="field">
        <label class="field__label" asp-for="ClientId"></label>
        <div class="field__control">
            <select class="input" id="ClientId" name="ClientId">
                @foreach (var client in clients)
                {
                    <option value="@client.Id" data-service-name="@client.ServiceName" selected="@(client.Id == selectedClient?.Id)">
                        @client.ServiceName — @client.DisplayName
                    </option>
                }
            </select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
        <span asp-validation-for="ClientId"></span>
    </div>

    <div class="field">
        <label class="field__label" for="ClientServiceName">Client service name</label>
        <input class="input mono" id="ClientServiceName" value="@selectedClient?.ServiceName" readonly/>
    </div>
</div>

<div class="field">
    <label class="field__label" asp-for="EmailType"></label>
    <input class="input mono" asp-for="EmailType" placeholder="Routing-key action, e.g. user-verify, user-password-reset, invoice"/>
    <span asp-validation-for="EmailType"></span>
</div>

<div class="field">
    <label class="field__label" asp-for="FromAddress"></label>
    <input class="input" asp-for="FromAddress" placeholder="e.g. no-reply@alaasmagi.dev"/>
    <span asp-validation-for="FromAddress"></span>
</div>

<div class="form-row">
    <div class="field">
        <label class="field__label" asp-for="DisplayName"></label>
        <input class="input" asp-for="DisplayName"/>
        <span asp-validation-for="DisplayName"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="ReplyTo"></label>
        <input class="input" asp-for="ReplyTo"/>
        <span asp-validation-for="ReplyTo"></span>
    </div>
</div>

<label class="check">
    <input asp-for="IsActive"/>
    <span>@Html.DisplayNameFor(m => m.IsActive)</span>
</label>

<script>
    (() => {
        const clientSelect = document.getElementById("ClientId");
        const serviceNameInput = document.getElementById("ClientServiceName");
        if (!clientSelect || !serviceNameInput) {
            return;
        }

        const syncServiceName = () => {
            serviceNameInput.value = clientSelect.selectedOptions[0]?.dataset.serviceName || "";
        };

        clientSelect.addEventListener("change", syncServiceName);
        syncServiceName();
    })();
</script>
