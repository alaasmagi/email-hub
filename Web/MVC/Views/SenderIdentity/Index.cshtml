@model IEnumerable<SenderIdentity>

@{
    ViewData["Title"] = "Sender identities";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">From address routing</p>
        <h1 class="page-title">Sender identities</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-card">
<table class="table table-hover align-middle">
    <thead>
    <tr>
        <th>Email type</th>
        <th>From</th>
        <th>Display name</th>
        <th>Reply-to</th>
        <th>Active</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var sender in Model)
    {
        <tr>
            <td>@sender.EmailType</td>
            <td>@sender.FromAddress</td>
            <td>@sender.DisplayName</td>
            <td>@sender.ReplyTo</td>
            <td>
                <span class="status-badge @(sender.IsActive ? "is-active" : "")">@(sender.IsActive ? "Active" : "Inactive")</span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@sender.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@sender.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this sender identity? Templates must be deleted first.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
