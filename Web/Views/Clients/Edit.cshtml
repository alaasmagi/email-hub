@model Client

@{
    ViewData["Title"] = "Edit client";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">Service mappings</p>
        <h1 class="page-title">Edit client</h1>
    </div>
</div>

<form asp-action="Edit" method="post" class="form-card vstack gap-3">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model"/>
    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
