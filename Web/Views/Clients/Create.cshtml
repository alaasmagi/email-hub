@model Client

@{
    ViewData["Title"] = "Create client";
}

<h1 class="h3 mb-3">Create client</h1>

<form asp-action="Create" method="post" class="vstack gap-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model"/>
    <div>
        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
