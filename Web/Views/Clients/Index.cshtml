@model IEnumerable<Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">Service mappings</p>
        <h1 class="page-title">Clients</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

<div class="table-card">
<table class="table table-hover align-middle">
    <thead>
    <tr>
        <th>Service name</th>
        <th>Display name</th>
        <th>Active</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var client in Model)
    {
        <tr>
            <td>@client.ServiceName</td>
            <td>@client.DisplayName</td>
            <td>
                <span class="status-badge @(client.IsActive ? "is-active" : "")">@(client.IsActive ? "Active" : "Inactive")</span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@client.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
