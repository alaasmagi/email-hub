@model IEnumerable<Email>

@{
    ViewData["Title"] = "Emails";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">Delivery log</p>
        <h1 class="page-title">Emails</h1>
    </div>
</div>

<div class="table-card">
<table class="table table-hover align-middle">
    <thead>
    <tr>
        <th>Service</th>
        <th>Type</th>
        <th>To</th>
        <th>Subject</th>
        <th>Status</th>
        <th>Sent at</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var email in Model)
    {
        <tr>
            <td>@email.ServiceName</td>
            <td>@email.EmailType</td>
            <td>@email.ToRecipients</td>
            <td>@email.Subject</td>
            <td><span class="status-badge">@email.Status</span></td>
            <td>@email.SentAt?.ToString("u")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@email.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
