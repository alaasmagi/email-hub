@model IEnumerable<Template>

@{
    ViewData["Title"] = "Templates";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">Razor email bodies</p>
        <h1 class="page-title">Templates</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

<div class="table-card">
<table class="table table-hover align-middle">
    <thead>
    <tr>
        <th>Sender identity</th>
        <th>Language</th>
        <th>Subject</th>
        <th>Active</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var template in Model)
    {
        <tr>
            <td><code>@template.SenderIdentityId</code></td>
            <td>@template.LanguageCode</td>
            <td>@template.SubjectTemplate</td>
            <td>
                <span class="status-badge @(template.IsActive ? "is-active" : "")">@(template.IsActive ? "Active" : "Inactive")</span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@template.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>
