@model SenderIdentity

@{
    ViewData["Title"] = "Create sender identity";
}

<div class="container">
<div class="page-header">
    <div>
        <p class="page-kicker">From address routing</p>
        <h1 class="page-title">Create sender identity</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="form-card vstack gap-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model"/>
    <div>
        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
