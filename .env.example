# Required
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=email_hub;Username=email_hub;Password=change-me
BREVO_API_KEY=change-me
KEYCLOAK_AUTHORITY=http://localhost:8080/realms/my-realm
KEYCLOAK_CLIENT_ID=email-hub-admin
KEYCLOAK_CLIENT_SECRET=change-me
RABBITMQ_URI=amqps://username:password@rabbitmq.example.com:5671/vhost
RABBITMQ_EXCHANGES=identity-events
RABBITMQ_EMAIL_QUEUE=email-hub.identity-email
GLITCHTIP_DSN=https://examplePublicKey@glitchtip.example.com/1

# Local development override when Keycloak is not served over HTTPS.
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

# Optional RabbitMQ tuning.
# RABBITMQ_EMAIL_PREFETCH=10
# RABBITMQ_RETRY_DELAY_SECONDS=10

# Optional
# BREVO_BASE_URL=https://api.brevo.com/v3
# GLITCHTIP_ENVIRONMENT=production
# GLITCHTIP_RELEASE=email-hub-local
# GLITCHTIP_SAMPLE_RATE=1.0
# LOG_LEVEL=Information
# MICROSOFT_LOG_LEVEL=Warning
# ENTITY_FRAMEWORK_LOG_LEVEL=Warning
# KEYCLOAK_CALLBACK_PATH=/signin-oidc
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:5000
